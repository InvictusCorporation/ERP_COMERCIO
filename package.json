{
  "name": "invictus-erp-comercial",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0 <27",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @invictus/contracts && npm run build -w @invictus/api && npm run build -w @invictus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @invictus/contracts && npm run test -w @invictus/api",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d database",
    "db:stop": "docker compose stop database"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
