# Copie somente se preferir configurar manualmente. npm run setup:local gera
# uma senha aleatória em .env, sem imprimir nem sobrescrever arquivo existente.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3333
WEB_PORT=3000
API_INTERNAL_URL=http://127.0.0.1:3333
POSTGRES_PORT=55432
POSTGRES_DB=invictus_dev
POSTGRES_USER=invictus_bootstrap
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
DATABASE_URL=postgresql://invictus_bootstrap:SUBSTITUA_POR_UMA_SENHA_LOCAL@127.0.0.1:55432/invictus_dev
